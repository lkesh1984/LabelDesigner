@using LabelDesigner.Server.Components.Svg
@using LabelDesigner.Shared.Widgets
@if (isOpen)
{
    <div class="modal-backdrop fade show"></div>
}
<div class="modal fade @(isOpen ? "show d-block" : "")" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <DesignerHeader></DesignerHeader>

            <div class="modal-body d-flex" style="height:70vh;">

                <!-- Left: Widget Canvas -->
                <WidgetCanvas Widgets="Widgets"
                              CanvasSettings="CanvasSettings"
                              SelectedWidget="SelectedWidget"
                              OnWidgetSelected="HandleWidgetSelected" />

                <!-- Right: Collapsible Properties Panel -->
                <div class="properties-wrapper d-flex flex-column">
                    <button class="btn btn-sm btn-outline-secondary mb-2 align-self-end"
                            @onclick="ToggleProperties">
                        @(ShowProperties ? "⮜" : "⮞")
                    </button>

                    @if (ShowProperties)
                        {
                        <PropertiesPanel SelectedWidget="SelectedWidget"
                                         OnWidgetChanged="StateHasChanged" />
                        }
                    </div>
                </div>

                <!-- Right: Close Button -->
                <div class="flex-shrink-0">
                    <button type="button" class="btn-close" @onclick="CloseDesigner"></button>
                </div>
            </div>
            <div class="modal-body d-flex" style="height:70vh;">
                <!-- Widget selector & canvas -->
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDesigner">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveLabel">Save</button>
            </div>
        </div>
    </div>

@code {
    [Parameter] 
    public EventCallback<string> OnSave { get; set; }
    public TemplateDesigner()
    {
        Widgets.Add(new RectangleWidget(
            CanvasSettings.ViewWidth/4,
            CanvasSettings.ViewHeight/4,
            CanvasSettings.ViewWidth/2 - CanvasSettings.ViewWidth/4/2, // placing in center.
            CanvasSettings.ViewHeight/2 - CanvasSettings.ViewHeight/4/2 // placing in center.
        ));

        Widgets.Add(new CircleWidget(
            CanvasSettings.ViewWidth / 4,
            CanvasSettings.ViewHeight / 4,
            CanvasSettings.ViewWidth / 2 - CanvasSettings.ViewWidth / 4 / 2, // placing in center.
            CanvasSettings.ViewHeight / 2 - CanvasSettings.ViewHeight / 4 / 2 // placing in center.
        ));
    }

    public List<Widget> Widgets { get; set; } = new();
    public Widget? SelectedWidget { get; set; }
    public CanvasSettings CanvasSettings { get; set; } = new();

    bool ShowProperties { get; set; } = true;

    void ToggleProperties() => ShowProperties = !ShowProperties;

    void HandleWidgetSelected(Widget widget)
    {
        SelectedWidget = widget;
        StateHasChanged();
    }
    private bool isOpen;

    private string labelName = "Barcode Template 1";
    private bool isEditingName = false;

    private ShapeType selectedShape = ShapeType.Rectangle;
    private void EnableEditing() => isEditingName = true;

    public void OpenDesigner() => isOpen = true;
    public void CloseDesigner() => isOpen = false;
    private void SaveLabelName()
    {
        if (string.IsNullOrWhiteSpace(labelName))
            labelName = "New Label";

        isEditingName = false;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            SaveLabelName();
        else if (e.Key == "Escape")
            isEditingName = false;
    }

    private void SelectShape(ShapeType shape)
    {
        selectedShape = shape;
        // Optional: Notify LabelDesigner of shape change
    }

    private async Task SaveLabel()
    {
        await OnSave.InvokeAsync("Shipping");
        CloseDesigner();
    }
    enum ShapeType
    {
        Rectangle,
        Line,
        Barcode,
        A
    }
}
