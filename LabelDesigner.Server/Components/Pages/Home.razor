@page "/"

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">My Labels</h4>
    <TemplateDesigner @ref="designer" OnSave="AddLabelFromDesigner" />
    <!-- Add new button -->
    <button class="btn btn-primary d-flex align-items-center gap-1" @onclick="() => designer.OpenDesigner()">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
             class="bi bi-plus-circle" viewBox="0 0 16 16">
            <path d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14m0-1A6 6 0 1 1 8 2a6 6 0 0 1 0 12" />
            <path d="M8 4a.5.5 0 0 1 .5.5V7.5h3a.5.5 0 0 1 0 1h-3V11a.5.5
                     0 0 1-1 0V8.5H4a.5.5 0 0 1 0-1h3V4.5A.5.5 0 0 1 8 4" />
        </svg>
        Add New
    </button>
</div>

@if (Labels.Count == 0)
{
    <!-- Empty state -->
    <div class="d-flex flex-column align-items-center justify-content-center p-5 text-muted">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor"
             class="bi bi-inboxes mb-3" viewBox="0 0 16 16">
            <path d="M4.98 0a.5.5 0 0 0-.4.2L.08 5.6A1.5 1.5 0 0 0 0 6v6.5A1.5
                         1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-.08-.4L11.42.2a.5.5
                         0 0 0-.4-.2H4.98zM1 6.5V6l4.22-5h5.56L15 6v.5h-4.5a.5.5 0 0 0-.5.5v2a.5.5
                         0 0 1-.5.5H6.5a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-.5-.5H1z" />
        </svg>
        <h5>No Labels Found</h5>
        <p class="mb-3">Start by creating your first label.</p>
        <button class="btn btn-outline-primary" @onclick="AddLabel">
            + Create Label
        </button>
    </div>
}
else
{
    <!-- Cards grid -->
    <div class="row g-3">
        @foreach (var label in Labels)
        {
            <div class="col-md-3">
                <div class="card label-card h-100">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <span>@label</span>

                        <!-- Edit icon (hidden until hover) -->
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor"
                             class="bi bi-pencil-square edit-icon" viewBox="0 0 16 16">
                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706l-1.043
                                             1.043-2-2L13.502.646a.5.5 0 0 1
                                             .707 0l1.293 1.293zM14.5 3.207l-2-2L4.939
                                             8.768a.5.5 0 0 0-.121.196l-.805
                                             2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5
                                             0 0 0 .196-.12L14.5 3.207z" />
                            <path fill-rule="evenodd"
                                  d="M1 13.5A1.5 1.5 0 0 0
                                             2.5 15h11a1.5 1.5 0 0 0
                                             1.5-1.5v-6a.5.5 0 0 0-1
                                             0v6a.5.5 0 0 1-.5.5h-11a.5.5
                                             0 0 1-.5-.5v-11a.5.5 0 0
                                             1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5
                                             1.5 0 0 0 1 2.5z" />
                        </svg>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    // TODO - call service layer
    private List<string> Labels = new(); // start empty
    private TemplateDesigner? designer;

    private void AddLabelFromDesigner(string lavel)
    {
        // Save the new label
        Labels.Add("New Label");
        // Optionally store widgets somewhere
    }
    private void AddLabel()
    {
        Labels.Add($"New Label {Labels.Count + 1}");
    }
}
