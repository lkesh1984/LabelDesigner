@using LabelDesigner.Server.Components.Svg

<div class="designer-header d-flex align-items-center justify-content-between px-3 py-2">
    <!-- LEFT: editable label -->
    <div class="left-area d-flex align-items-center gap-2 flex-shrink-0">
        @if (isEditingName)
        {
            <input @bind="labelName" @bind:event="oninput"
                   @onblur="SaveLabelName"
                   @onkeydown="HandleKeyDown"
                   class="form-control form-control-sm label-input" />
        }
        else
        {
            <div class="d-flex align-items-center gap-1 label-display-wrapper" @onclick="EnableEditing" style="cursor:pointer;">
                <h5 class="mb-0 fw-semibold label-display">@labelName</h5>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                     class="edit-icon" viewBox="0 0 16 16">
                    <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-9.5 9.5L4 13l.646-2.354 9.5-9.5zM11.207 2L13 3.793 14.793 2 13 0.207 11.207 2zM4.5 13.5 1 15l1.5-3.5L4.5 13.5z" />
                </svg>
            </div>
        }
    </div>

    <!-- CENTER: shape toolbar (centered) -->
    <div class="center-area flex-grow-1 d-flex justify-content-center">
        <div class="shape-group" role="toolbar" aria-label="Shape selection">
            <button type="button"
                    class="shape-item btn-reset @(selectedShape == WidgetType.Text ? "selected" : "")"
                    @onclick="() => SelectShapeAsync(WidgetType.Text)"
                    title="Text"
                    aria-pressed="@(selectedShape == WidgetType.Text)">
                <svg viewBox="0 0 100 100" width="100%" height="100%">
                    <text x="50" y="60" text-anchor="middle" font-size="60" font-family="Arial" fill="black">T</text>
                </svg>
            </button>

            <button type="button"
                    class="shape-item btn-reset @(selectedShape == WidgetType.Rectangle ? "selected" : "")"
                    @onclick="() => SelectShapeAsync(WidgetType.Rectangle)"
                    title="Rectangle"
                    aria-pressed="@(selectedShape == WidgetType.Rectangle)">
                <RectangleSvg />
            </button>

            <button type="button"
                    class="shape-item btn-reset @(selectedShape == WidgetType.Barcode ? "selected" : "")"
                    @onclick="() => SelectShapeAsync(WidgetType.Barcode)"
                    title="Barcode"
                    aria-pressed="@(selectedShape == WidgetType.Barcode)">
                <BarcodeSvg />
            </button>

            <button type="button"
                    class="shape-item btn-reset @(selectedShape == WidgetType.Circle ? "selected" : "")"
                    @onclick="() => SelectShapeAsync(WidgetType.Circle)"
                    title="Circle"
                    aria-pressed="@(selectedShape == WidgetType.Circle)">
                <CircleSvg />
            </button>

            <button type="button"
                    class="shape-item btn-reset @(selectedShape == WidgetType.Line ? "selected" : "")"
                    @onclick="() => SelectShapeAsync(WidgetType.Line)"
                    title="Line"
                    aria-pressed="@(selectedShape == WidgetType.Line)">
                <LineSvg />
            </button>
        </div>
    </div>

    <!-- RIGHT: close -->
    <div class="right-area flex-shrink-0">
        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDesigner"></button>
    </div>
</div>

@code {
    // state (replace/merge with your existing state)
    private string labelName { get; set; } = "My Label";
    private bool isEditingName { get; set; } = false;
    private WidgetType selectedShape { get; set; } = WidgetType.None;

    // TODO: sync with Shared Enum.cs
    public enum WidgetType
    {
        None,
        Text,
        Rectangle,
        Line,
        Circle,
        Barcode,
        A
    }

    [Parameter] public EventCallback<WidgetType> OnShapeSelected { get; set; }
    [Parameter] public EventCallback<string> OnLabelSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    void EnableEditing()
    {
        isEditingName = true;
    }

    async Task SaveLabelName()
    {
        isEditingName = false;
        if (OnLabelSaved.HasDelegate) await OnLabelSaved.InvokeAsync(labelName);
    }

    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SaveLabelName();
        }
        else if (e.Key == "Escape")
        {
            isEditingName = false;
        }
    }

    async Task SelectShapeAsync(WidgetType shapeType)
    {
        selectedShape = shapeType;
        if (OnShapeSelected.HasDelegate) await OnShapeSelected.InvokeAsync(selectedShape);
    }

    async Task CloseDesigner()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }
}
